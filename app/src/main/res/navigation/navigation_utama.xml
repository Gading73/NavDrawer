<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_utama"
    android:label="HOME"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="c14220073.navdrawer.HomeFragment"
        android:label="home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="c14220073.navdrawer.ProfileFragment"
        android:label="profile"
        tools:layout="@layout/fragment_profile" >
        <!-- Ini adalah jembatan yang hilang di kode Anda -->
        <action
            android:id="@+id/action_profileFragment_to_detailProfileFragment"
            app:destination="@id/detailProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="c14220073.navdrawer.SettingFragment"
        android:label="setting"
        tools:layout="@layout/fragment_setting" />

    <fragment
        android:id="@+id/detailProfileFragment"
        android:name="c14220073.navdrawer.DetailProfileFragment"
        android:label="fragment_detail_profile"
        tools:layout="@layout/fragment_detail_profile" />
</navigation>